# Mặc định: mọi file text dùng LF trong working tree lẫn repo (Windows và Linux giống nhau, không phụ thuộc core.autocrlf).
# Thuộc tính trong repo thắng core.autocrlf của từng máy → hết cảnh báo "LF will be replaced by CRLF".
* text=auto eol=lf

# Script/config bắt buộc LF (CRLF làm hỏng shebang, heredoc, source .env)
*.sh   text eol=lf
*.py   text eol=lf
*.env  text eol=lf
scripts/git-hooks/* text eol=lf

# Code & build
*.c    text eol=lf
*.cc   text eol=lf
*.cpp  text eol=lf
*.cxx  text eol=lf
*.h    text eol=lf
*.hh   text eol=lf
*.hpp  text eol=lf
*.idl  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.ld   text eol=lf
*.service text eol=lf

# Tài liệu/cấu hình
*.md   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
.clang-format text eol=lf
.clang-tidy text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Nhị phân: không đụng line ending, không diff text
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
*.bin  binary
*.elf  binary
*.a    binary
*.so   binary
