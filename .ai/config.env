# ===== Cấu hình đội AI — VinSurgical template v2 =====
# File này là cấu hình được kiểm soát (configuration item). AI worker không được sửa (check_scope.py chặn).
PYTHON="python"                    # Windows Git Bash: python ; Linux/WSL: python3

# ---- Worker AI: Antigravity CLI (`agy`, thay Gemini CLI từ 06/2026) ----
# Model: slug từ `agy models` (slug đã gồm mức suy luận, vd. -low/-medium/-high). Để trống → script từ chối chạy.
# Đổi model/phiên bản agy = thay đổi công cụ → tái validate (docs/01-plan §3).
# AI KHÔNG chạy lệnh shell (agy -p bỏ qua allow-list, issue #548): worker chỉ đọc/sửa file, delegate.sh chạy gate và gửi lỗi lại.
# Chính sách tool nằm trong repo: .agents/hooks.json → .agents/hooks/vsur_policy.py (không cấu hình gì trong ~/.gemini).
AGY_BIN="agy"                      # phải có trong PATH của shell chạy script (agy install), hoặc đường dẫn đầy đủ
AGY_MODEL_LOW="gemini-3.8-flash-medium"
AGY_MODEL_HIGH="gemini-3.1-pro-high"   # cũng dùng cho cross-review → KHÔNG dùng model Claude (phải khác họ model với Lead)
AGY_TIMEOUT=900                    # giây mỗi lượt gọi agy (truyền vào --print-timeout)
AGY_SANDBOX=""                     # "1" → agy --sandbox. Windows: cần quyền admin (escalate_admin) → headless bị chặn; chỉ bật trên Linux
AGY_DENY_RETRY=1                   # AI cố chạy lệnh bị chặn → tự resume N lần với lời nhắc chỉ đọc/sửa file
# Danh tính commit trong worktree → phân biệt code AI worker / AI lead trong lịch sử (bằng chứng nguồn gốc)
AI_WORKER_NAME="ai-worker (agy)"; AI_WORKER_EMAIL="ai-worker@localhost"
AI_LEAD_NAME="ai-lead (claude)";     AI_LEAD_EMAIL="ai-lead@localhost"

# ---- Build theo nền tảng (platform trong task card: host | mcu | linux | qnx) ----
# ccache tăng tốc build mỗi worktree (tự bật nếu có; tắt nếu gây lỗi coverage)
LAUNCHER=""; command -v ccache >/dev/null 2>&1 && LAUNCHER="-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache"
BUILD_CMD_host="cmake -S . -B build/host -DCMAKE_BUILD_TYPE=Debug -DENABLE_COVERAGE=ON $LAUNCHER >/dev/null && cmake --build build/host"
BUILD_CMD_mcu="cmake -S . -B build/mcu --toolchain cmake/arm-none-eabi.cmake $LAUNCHER >/dev/null && cmake --build build/mcu"
BUILD_CMD_linux="cmake -S . -B build/linux --toolchain cmake/linux-aarch64.cmake $LAUNCHER >/dev/null && cmake --build build/linux"
# QNX: cần QNX SDP; nạp môi trường trước (qnxsdp-env.sh) hoặc dùng toolchain file gọi qcc/q++
BUILD_CMD_qnx="source \"\${QNX_SDP:-/opt/qnx}/qnxsdp-env.sh\" && cmake -S . -B build/qnx --toolchain cmake/qnx-aarch64le.cmake >/dev/null && cmake --build build/qnx"

# Unit test luôn chạy trên host (logic tách khỏi HAL/OS qua lớp trừu tượng)
TEST_CMD="ctest --test-dir build/host --output-on-failure"

# ---- Phân tích tĩnh & coverage ----
# Placeholder do gate.sh thay theo phạm vi (task: file thay đổi so với base / --scope; release: --full):
#   {FILES} = mọi file nguồn trong phạm vi · {SRCS} = chỉ .c/.cc/.cpp · {COV_FILTER} = các --filter của gcovr
# Ngưỡng không phụ thuộc phạm vi. Release-check chạy gate --full hoặc --scope theo từng SI.
LINT_CMD="cppcheck --enable=warning,style,performance,portability --error-exitcode=1 --inline-suppr -q --std=c++17 {SRCS}"
TIDY_CMD="clang-tidy -p build/host --quiet --warnings-as-errors='*' {SRCS}"
# Công cụ MISRA thương mại (Helix QAC / Polyspace / Parasoft / PC-lint Plus) — bắt buộc cho Class B/C
MISRA_CMD=""
REQUIRE_MISRA=0                    # 1 sau khi đã cài/validate tool; bắt buộc trước pilot/release B/C
COV_CMD_B="gcovr -r . {COV_FILTER} --fail-under-line 90"
COV_CMD_C="gcovr -r . {COV_FILTER} --fail-under-line 100 --fail-under-branch 100"
# MC/DC cho Class C cần công cụ chuyên dụng (VectorCAST, LDRA, Testwell CTC++...) — bắt buộc cho Class C
MCDC_CMD=""
REQUIRE_MCDC=0                     # 1 sau khi đã cài/validate tool; bắt buộc trước pilot/release C

# ---- Hành vi worker ----
AUTOFIX_MAX_DEFAULT=0              # 0 = mọi lỗi build đều hỏi Lead
GATE_TAIL=20
MAX_REWORK=3                       # quá số vòng REWORK → delegate.sh từ chối --resume (abort, tự làm hoặc chia nhỏ)

# ---- Kiểm soát con người (IEC 62304 / QMS) ----
# Class nào bắt buộc có chữ ký kỹ sư (HUMAN_REVIEWER) trong .ai/reviews/<ID>.md trước khi merge
HUMAN_SIGNOFF_CLASSES="B C"
# text: kiểm tra trường HUMAN_* (AI bị hook chặn điền) · gpg: thêm yêu cầu kỹ sư commit file review bằng commit ký GPG
# Khuyến nghị gpg khi dùng cho phần mềm phát hành (QA quyết định).
SIGNOFF_MODE="text"
MERGE_RERUN_GATE=1                 # merge.sh chạy lại scope + gate + trace tại SHA đã ký
